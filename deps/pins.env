# computeAccel 外部依赖版本 pin（唯一事实来源）
# 更新依赖时改这里，然后跑 tools/fetch_deps.sh + tools/check_abi_drift.sh。
#
# 约束：native 与 browser 两条链路都实现同一个 webgpu.h C ABI，
#       两边版本升级后必须跑 tools/check_abi_drift.sh 确认 compute 子集签名未变。

# native 端 WebGPU 实现（Rust/cargo，产出 libwgpu_native.so）
WGPU_NATIVE_VERSION="v29.0.1.1"
WGPU_NATIVE_ASSET="wgpu-linux-x86_64-release.zip"
WGPU_NATIVE_URL="https://github.com/gfx-rs/wgpu-native/releases/download/${WGPU_NATIVE_VERSION}/${WGPU_NATIVE_ASSET}"

# browser 端 WebGPU 实现（Dawn 的 emscripten port）
# 已入库的 remote port 文件：deps/emdawnwebgpu.remoteport.py（内含同一版本号）
EMDAWNWEBGPU_VERSION="v20260911.162847"
EMDAWNWEBGPU_REMOTEPORT_URL="https://github.com/google/dawn/releases/download/${EMDAWNWEBGPU_VERSION}/emdawnwebgpu-${EMDAWNWEBGPU_VERSION}.remoteport.py"
